# Copy to .env and fill in. Never commit .env.

# Public address of the NAS, as the apps reach it (HTTPS required for passkeys).
# With DuckDNS + the shared reverse proxy in proxy/: https://anime.<name>.duckdns.org
AnimeRoll__PublicBaseUrl=https://anime.example.com

# openssl rand -hex 32
AnimeRoll__Jwt__Key=

# Set to false after creating your account
AnimeRoll__AllowRegistration=true

# Passkeys: domain without https://, and the allowed origins
AnimeRoll__Passkey__ServerDomain=anime.example.com
AnimeRoll__Passkey__Origins__0=https://anime.example.com

# Android app (passkeys): SHA-256 of the signing certificate (keytool -list -v)
#AnimeRoll__Android__Sha256CertFingerprints__0=AB:CD:...

# Apple apps (passkeys): TEAMID.bundleid
AnimeRoll__Apple__AppIds__0=ABCDE12345.com.kurozetsubou.animeroll
AnimeRoll__Apple__AppIds__1=ABCDE12345.com.kurozetsubou.animeroll.tv

# AniList: https://anilist.co/settings/developer  (redirect: https://anime.example.com/api/anilist/callback)
AnimeRoll__AniList__ClientId=
AnimeRoll__AniList__ClientSecret=

# qBittorrent (Torrent)
AnimeRoll__QBittorrent__Url=http://qbittorrent:8081
AnimeRoll__QBittorrent__Username=admin
AnimeRoll__QBittorrent__Password=

# Telegram: https://my.telegram.org/apps
AnimeRoll__Telegram__ApiId=0
AnimeRoll__Telegram__ApiHash=
AnimeRoll__Telegram__PhoneNumber=+39...

# Plugins (see PLUGINS.md): one folder per plugin in ANIMEROLL_PLUGINS.
# Settings/secrets per plugin: AnimeRoll__Plugins__Settings__<plugin-id>__<key>=value
# AnimeRoll__Plugins__Settings__my-service__username=

# NAS paths and file owner (run `id` on the NAS)
PUID=1000
PGID=1000
ANIMEROLL_DATA=/volume1/docker/animeroll/data
ANIMEROLL_MEDIA=/volume1/docker/animeroll/media
ANIMEROLL_DOWNLOADS=/volume1/docker/animeroll/downloads
ANIMEROLL_PLUGINS=/volume1/docker/animeroll/plugins
ANIMEROLL_QBT=/volume1/docker/animeroll/qbittorrent
