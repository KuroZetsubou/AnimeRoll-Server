# https://www.duckdns.org → your token, and the name of your domain (without .duckdns.org)
DUCKDNS_TOKEN=
DUCKDNS_NAME=animeroll
# Let's Encrypt expiry notices
ACME_EMAIL=
PUID=1000
PGID=10
PROXY_DATA=/volume1/docker/proxy
# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels → your tunnel → Docker). Start with: docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=
